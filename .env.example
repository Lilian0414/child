# API. Local default shown; Railway staging must use
# sqlite:////data/child_agent.db with a volume mounted at /data.
CHILD_DATABASE_URL=sqlite:///./child_agent.db
CHILD_OBSERVER_API_KEY=
CHILD_OBSERVER_MODEL=
CHILD_OBSERVER_BASE_URL=

# TTS
ELEVENLABS_API_KEY=

# Live VLM + story generation. CHILD_LIVE_MODE selects which one is used:
# "gemma" (via HF_TOKEN, Hugging Face router), "minimax" (via GMI_API_KEY,
# GMI Cloud), or unset/anything else — fully offline, network-free demo
# providers (no external call, no instability on stage). Use "demo" for the
# first Railway staging deployment; provider keys below remain optional.
CHILD_LIVE_MODE=demo
HF_TOKEN=
GMI_API_KEY=
